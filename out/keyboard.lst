    92 2070 18			        clc                             ; clear carry flag
    93 2071 69 30		        adc #offset_to_char             ; convert the digit in A to ATASCII
    94 2073 20 8A 20		        jsr putchar
    95
    96 				; print the second digit
    97 2076 A5 81		        lda doubled
    98 2078 18			        clc
    99 2079 69 30		        adc #offset_to_char
