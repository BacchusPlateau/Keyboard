    82 				; =====================================================================
    83 				; PUTCHAR SUBROUTINE
    84 				; prints the character whose ATASCII value is in the A register
    85 				; by jumping to the OS print routine via stack manipulation
    86 				; ON ENTRY: A must contain the ATASCII value of the character to print
    87 				; ON EXIT:  A is preserved, character has been printed to screen
    88 				; =====================================================================
    89
    90 2059			        .proc putchar
    91 2059 AA			        tax             ; X = A                       (save character from A into X because A is about to be clobbered)
    92 205A AD 47 03		        lda putchar_ptr+1 ; A = memory[$347]          (load high byte of OS print routine address)
    93 205D 48			        pha             ; push A onto stack            (high byte on stack, will be popped second by rts)
    94 205E AD 46 03		        lda putchar_ptr ; A = memory[$346]            (load low byte of OS print routine address)
    95 2061 48			        pha             ; push A onto stack            (low byte on stack, will be popped first by rts)
    96 2062 8A			        txa             ; A = X                       (restore original character back into A because OS print routine expects character value in A)
    97 2063 60			        rts             ; RETURN                      (pops OS address from stack and jumps there, OS prints character in A, then returns to main)
    98 				        .endp           ; end of putchar procedure
    99
