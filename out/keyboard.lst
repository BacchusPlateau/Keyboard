    39 				; Wait for a key to be pressed          
    40 2022			wait_for_keypress:
    41 2022 AD FC 02		        lda ch                          ; a = $2FC
    42 2025 C9 FF		        cmp #no_key                     ; test if a == $ff.  NOTE the # symbol denotes the following is a literal not an address
    43 2027 F0 F9		        beq wait_for_keypress           ; if not, loop back and try again
    44 				        
    45 				; Loop through keytable data and try to find a match on the keyboard scancode
    46 2029 A2 00		        ldx #0                          ; init x=0
    47 202B			find_key:
    48 202B DD AB 20		        cmp keytable,x                  ; compare what is in a to keytable[x], does a = keytable[x]
    49 202E F0 08		        beq found                       ; if equal, GOTO found
    50 2030 E8			        inx                             ; increment x:  x = x + 1
    51 2031 E0 0A		        cpx #10                         ; compare if x = 10
    52 2033 D0 F6		        bne find_key                    ; if it does not, loop again
    53 2035 4C 87 20		        jmp stop                        ; we didn't find a match after looping through all of the values.  stop
    54
    55 				; echo the number pressed back to the screen
    56 2038			found:
    57 2038 8A			        txa                             ; a = x
    58 2039 85 82		        sta value                       ; memory[value] = a
    59 203B 18			        clc                             ; clear carry                                       
    60 203C 69 30		        adc #offset_to_char             ; convert to ATASCII by adding $30
    61 203E 20 8A 20		        jsr putchar                     ; print the number pressed
    62 2041 A9 07 85 54		        mva #7 rowcrs                   ; memory[$54] = 6             (position cursor at row 7)
    63 2045 A9 0A 85 55		        mva #10 colcrs                  ; memory[$55] = 11            (position cursor at column 10)
    64
    65 				; write the text label for the doubled value
    66 2049 A9 00 85 80		        mva #0 character                ; reset our loop counter
    67 204D			next_label_ch:
    68 204D A6 80		        ldx character                   ; X = memory[$80]             (load current loop index into X)
    69 204F E0 0F		        cpx #.len outputlabel           ; compare X to length of outputlabel (are we done yet?)
    70 2051 F0 0B		        beq double_the_value            ; if X == length then GOTO wait_for_keypress to get keyboard input
    71 2053 BD B5 20		        lda outputlabel,x               ; A = memory[outputlabel + X]        (load character at position X from text)
    72 2056 20 8A 20		        jsr putchar                     ; CALL putchar                (putchar expects character value in A)
    73 2059 E6 80		        inc character                   ; memory[$80] = memory[$80]+1 (advance loop index to next character)
    74 205B 4C 4D 20		        jmp next_label_ch               ; GOTO next_label_ch      (go back and print next character)
    75
    76 205E			double_the_value:
    77 205E A5 82		        lda value                       ; a = memory[value]
    78 2060 85 81		        sta doubled                     ; STORE a in memory location 'doubled': memory[doubled] = a
    79 2062 18			        clc                             ; clear the carry flag
    80 2063 65 81		        adc doubled                     ; add the value in memory location 'doubled' to a: a = a + memory[doubled]
    81 				                                        ; (no # = read from memory address)
    82 2065 C9 0A		        cmp #10                         ; test if A == 10
    83 2067 90 18		        bcc print_one_digit             ; branch if less than 10 to print_one_digit
    84
    85 				; print two characters. we shall assume that the first digit is always '1'
    86 2069 38			        sec                             ; set the carry flag - required for subtracting
    87 206A E9 0A		        sbc #10                         ; a = a - 10
    88 206C 85 81		        sta doubled                     ; memory[doubled] = a    //save the result
    89 				        
    90 				; print the character '1'
