    23 				; Print out the prompt
    24 2011			next_character:         ; next_character:              (loop entry point)
    25 2011 A6 80		        ldx character   ; X = memory[$80]             (load current loop index into X)
    26 2013 E0 10		        cpx #.len text  ; compare X to length of text (are we done yet?)
    27 2015 F0 0B		        beq wait_for_keypress        ; if X == length then GOTO wait_for_keypress to get keyboard input
    28 2017 BD 4D 20		        lda text,x      ; A = memory[text + X]        (load character at position X from text)
    29 201A 20 42 20		        jsr putchar     ; CALL putchar                (putchar expects character value in A)
    30 201D E6 80		        inc character   ; memory[$80] = memory[$80]+1 (advance loop index to next character)
    31 201F 4C 11 20		        jmp next_character ; GOTO next_character      (go back and print next character)
