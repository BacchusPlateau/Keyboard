    27 				; Print out the prompt
    28 2011			next_character:         ; next_character:              (loop entry point)
    29 2011 A6 80		        ldx character   ; X = memory[$80]             (load current loop index into X)
    30 2013 E0 10		        cpx #.len text  ; compare X to length of text (are we done yet?)
    31 2015 F0 0B		        beq wait_for_keypress        ; if X == length then GOTO wait_for_keypress to get keyboard input
    32 2017 BD 51 20		        lda text,x      ; A = memory[text + X]        (load character at position X from text)
    33 201A 20 46 20		        jsr putchar     ; CALL putchar                (putchar expects character value in A)
    34 201D E6 80		        inc character   ; memory[$80] = memory[$80]+1 (advance loop index to next character)
    35 201F 4C 11 20		        jmp next_character ; GOTO next_character      (go back and print next character)
    36
    37 				; Wait for a key to be pressed
    38 2022			wait_for_keypress:
    39 2022 AD FC 02		        lda ch                      ; a = $2FC
    40 2025 C9 FF		        cmp #no_key                 ; test if a == $ff.  NOTE the # symbol denotes the following is a literal not an address
    41 2027 F0 F9		        beq wait_for_keypress       ; if not, loop back and try again
    42 				        
    43 2029 A2 00		        ldx #0                      ; init x=0
    44 202B			find_key:
    45 202B DD 61 20		        cmp keytable,x              ; compare what is in a to keytable[x], does a = keytable[x]
    46 202E F0 08		        beq found                   ; if equal, GOTO found
    47 2030 E8			        inx                         ; increment x:  x = x + 1
    48 2031 E0 0A		        cpx #10                     ; compare if x = 10
    49 2033 D0 F6		        bne find_key                ; if it does not, loop again
    50 2035 4C 43 20		        jmp stop                    ; we didn't find a match after looping through all of the values.  stop
    51
    52 2038			found:
    53 2038 8A			        txa                         ; a = x
    54 2039 85 81		        sta doubled                 ; STORE a in memory location 'doubled': memory[doubled] = a
    55 203B 18			        clc                         ; clear the carry flag
    56 203C 65 81		        adc doubled                 ; add the value in memory location 'doubled' to a: a = a + memory[doubled]
    57 				                                    ; (no # = read from memory address)
    58 203E 69 30		        adc #offset_to_char         ; a = a + $30
    59 				                                    ; (# so we use the literal value)
    60 2040 20 46 20		        jsr putchar                 ; print a
    61
    62
    63
    64 2043			stop:
    65 2043 4C 43 20		        jmp stop        ; GOTO stop                   (infinite loop = program halts here)
