     5 = 0346			putchar_ptr = $346      ; CONSTANT: putchar_ptr = $346 (OS character output vector address)
     6 = 02F0			csrhinh     = $2F0      ; CONSTANT: csrhinh = $2F0 (OS cursor visible/hidden control address)
     7 = 0054			rowcrs      = $54       ; CONSTANT: rowcrs = $54 (OS zero page address that controls cursor row)
     8 = 0055			colcrs      = $55       ; CONSTANT: colcrs = $55 (OS zero page address that controls cursor column)
     9 = 0020			space       = $20       ; ATASCII space is at hex 20 or $20
    10 = 0030			offset_to_char = $30    ; Offset from integer literal to ATASCII character equivalent of the number
    11 = 02FC			ch          = $2FC      ; CONSTANT: ch = $2FC (OS last key pressed register)
    12 = 02FB			atachr      = $2FB      ; CONSTANT: atachr = $2FB (OS ATASCII value of last key pressed)
    13 = 00FF			no_key      = $FF       ; value in ch when no key is pressed
    14
    15 = 0080			character   = $80       ; CONSTANT: character = $80 (zero page address we use as loop index)
    16 = 0081			doubled     = $81       ; CONSTANT: temporary storage for doubling
    17 = 0082			value       = $82       ; CONSTANT: temporary storage for the selected number to be doubled
    18
    19 				        org $2000                       ; place the following code at memory address $2000
    20
    21
    22 				        .proc main                      ; declare procedure named "main", begin its scope
    23
    24 FFFF> 2000-20C3> A9 01 +         mva #1 csrhinh                  ; memory[752] = 1             (hide the cursor)
    25 2005 A9 06 85 54		        mva #6 rowcrs                   ; memory[$54] = 6             (position cursor at row 6)
    26 2009 A9 0A 85 55		        mva #10 colcrs                  ; memory[$55] = 10            (position cursor at column 10)
    27 200D A9 00 85 80		        mva #0 character                ; memory[$80] = 0    (initialize loop index to 0)
