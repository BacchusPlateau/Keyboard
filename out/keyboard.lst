    18 FFFF> 2000-2066> A9 01 +         mva #1 csrhinh  ; memory[752] = 1             (hide the cursor)
    19 2005 A9 06 85 54		        mva #6 rowcrs   ; memory[$54] = 6             (position cursor at row 6)
    20 2009 A9 0A 85 55		        mva #10 colcrs  ; memory[$55] = 10            (position cursor at column 10)
    21 200D A9 00 85 80		        mva #0 character    ; memory[$80] = 0    (initialize loop index to 0)
