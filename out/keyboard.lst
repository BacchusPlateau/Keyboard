   114 				; =====================================================================
   115 				; PUTCHAR SUBROUTINE
   116 				; prints the character whose ATASCII value is in the A register
   117 				; by jumping to the OS print routine via stack manipulation
   118 				; ON ENTRY: A must contain the ATASCII value of the character to print
   119 				; ON EXIT:  A is preserved, character has been printed to screen
   120 				; =====================================================================
   121
   122 208A			        .proc putchar
   123 208A AA			        tax             ; X = A                       (save character from A into X because A is about to be clobbered)
   124 208B AD 47 03		        lda putchar_ptr+1 ; A = memory[$347]          (load high byte of OS print routine address)
   125 208E 48			        pha             ; push A onto stack            (high byte on stack, will be popped second by rts)
   126 208F AD 46 03		        lda putchar_ptr ; A = memory[$346]            (load low byte of OS print routine address)
   127 2092 48			        pha             ; push A onto stack            (low byte on stack, will be popped first by rts)
   128 2093 8A			        txa             ; A = X                       (restore original character back into A because OS print routine expects character value in A)
   129 2094 60			        rts             ; RETURN                      (pops OS address from stack and jumps there, OS prints character in A, then returns to main)
   130 				        .endp           ; end of putchar procedure
   131
   132 2095			        .local text     ; declare local data block named "text"
   133 2095 45 4E 54 45 52 20 +         .byte 'ENTER A NUMBER (0-9): ' ; raw ATASCII bytes for each character in the string
   134 				        .endl           ; end of text data block
   135
   136 20AB			        .local keytable
   137 20AB 32 1F 1E 1A 18 1D +         .byte $32,$1F,$1E,$1A,$18,$1D,$1B,$33,$35,$30
   138 				        .endl
   139
   140 20B5			        .local outputlabel
   141 20B5 44 4F 55 42 4C 45 +         .byte 'DOUBLED VALUE: '
   142 				        .endl
   143
   144 				        .endp           ; end of main procedure
   145
