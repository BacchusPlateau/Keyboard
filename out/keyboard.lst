    33 				; Wait for a key to be pressed
    34 2022			wait_for_keypress:
    35 2022 AD FC 02		        lda ch                      ; a = $2FC
    36 2025 C9 FF		        cmp #no_key                 ; test if a == $ff.  NOTE the # symbol denotes the following is a literal not an address
    37 2027 F0 F9		        beq wait_for_keypress       ; if not, loop back and try again
    38 				        
    39 2029 A2 00		        ldx #0                      ; init x=0
    40 202B			find_key:
