     2 = 0346			putchar_ptr = $346      ; CONSTANT: putchar_ptr = $346 (OS character output vector address)
     3 = 02F0			csrhinh     = $2F0      ; CONSTANT: csrhinh = $2F0 (OS cursor visible/hidden control address)
     4 = 0054			rowcrs      = $54       ; CONSTANT: rowcrs = $54 (OS zero page address that controls cursor row)
     5 = 0055			colcrs      = $55       ; CONSTANT: colcrs = $55 (OS zero page address that controls cursor column)
     6 = 0020			space       = $20       ; ATASCII space is at hex 20 or $20
     7 = 0030			offset_to_char = $30    ; Offset from integer literal to ATASCII character equivalent of the number
     8 = 0080			character   = $80       ; CONSTANT: character = $80 (zero page address we use as loop index)
     9 = 02FC			ch          = $2FC      ; CONSTANT: ch = $2FC (OS last key pressed register)
    10 = 02FB			atachr      = $2FB      ; CONSTANT: atachr = $2FB (OS ATASCII value of last key pressed)
    11 = 00FF			no_key      = $FF           ; value in ch when no key is pressed
    12
    13 				        org $2000       ; place the following code at memory address $2000
    14
    15
    16 				        .proc main      ; declare procedure named "main", begin its scope
