    39 				; Wait for a key to be pressed          
    40 2022			wait_for_keypress:
    41 2022 AD FC 02		        lda ch                          ; a = $2FC
    42 2025 C9 FF		        cmp #no_key                     ; test if a == $ff.  NOTE the # symbol denotes the following is a literal not an address
    43 2027 F0 F9		        beq wait_for_keypress           ; if not, loop back and try again
    44 				        
    45 				; Loop through keytable data and try to find a match on the keyboard scancode
    46 2029 A2 00		        ldx #0                          ; init x=0
    47 202B			find_key:
    48 202B DD 74 20		        cmp keytable,x                  ; compare what is in a to keytable[x], does a = keytable[x]
    49 202E F0 08		        beq found                       ; if equal, GOTO found
    50 2030 E8			        inx                             ; increment x:  x = x + 1
    51 2031 E0 0A		        cpx #10                         ; compare if x = 10
    52 2033 D0 F6		        bne find_key                    ; if it does not, loop again
    53 2035 4C 56 20		        jmp stop                        ; we didn't find a match after looping through all of the values.  stop
    54
    55 				; echo the number pressed back to the screen
    56 2038			found:
    57 2038 8A			        txa                             ; a = x
    58 2039 85 82		        sta value                       ; memory[value] = a
    59 203B 18			        clc                             ; clear carry                                       
    60 203C 69 30		        adc #offset_to_char             ; convert to ATASCII by adding $30
    61 203E 20 59 20		        jsr putchar                     ; print the number pressed
    62 2041 A9 06 85 54		        mva #6 rowcrs                   ; memory[$54] = 6             (position cursor at row 6)
    63 2045 A9 0B 85 55		        mva #11 colcrs                  ; memory[$55] = 11            (position cursor at column 11)
