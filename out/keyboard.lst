    67 				; =====================================================================
    68 				; PUTCHAR SUBROUTINE
    69 				; prints the character whose ATASCII value is in the A register
    70 				; by jumping to the OS print routine via stack manipulation
    71 				; ON ENTRY: A must contain the ATASCII value of the character to print
    72 				; ON EXIT:  A is preserved, character has been printed to screen
    73 				; =====================================================================
    74
    75 2046			        .proc putchar
    76 2046 AA			        tax             ; X = A                       (save character from A into X because A is about to be clobbered)
    77 2047 AD 47 03		        lda putchar_ptr+1 ; A = memory[$347]          (load high byte of OS print routine address)
    78 204A 48			        pha             ; push A onto stack            (high byte on stack, will be popped second by rts)
    79 204B AD 46 03		        lda putchar_ptr ; A = memory[$346]            (load low byte of OS print routine address)
    80 204E 48			        pha             ; push A onto stack            (low byte on stack, will be popped first by rts)
    81 204F 8A			        txa             ; A = X                       (restore original character back into A because OS print routine expects character value in A)
    82 2050 60			        rts             ; RETURN                      (pops OS address from stack and jumps there, OS prints character in A, then returns to main)
    83 				        .endp           ; end of putchar procedure
    84
    85 2051			        .local text     ; declare local data block named "text"
    86 2051 45 4E 54 45 52 20 +         .byte 'ENTER A NUMBER: ' ; raw ATASCII bytes for each character in the string
    87 				        .endl           ; end of text data block
    88
    89 2061			        .local keytable
    90 2061 32 1F 1E 1A 18 1D +         .byte $32,$1F,$1E,$1A,$18,$1D,$1B,$33,$35,$30
    91 				        .endl
    92
    93 				        .endp           ; end of main procedure
    94
    95 				; =====================================================================
    96 				; ENTRY POINT
    97 				; =====================================================================
    98
    99 02E0-02E1> 00 20		        run main        ; set Atari run address to main (auto-execute when program loads)
