   104 				;print one digit
   105 2081			print_one_digit:                                        
   106 2081 18			        clc                             ; clear carry
   107 2082 69 30		        adc #offset_to_char             ; a = a + $30
   108 				                                        ; (# so we use the literal value)
   109 2084 20 8A 20		        jsr putchar                     ; print a
